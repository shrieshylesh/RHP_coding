#include <bits/stdc++.h>
using namespace std;
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        vector<int> cnt(4 * n + 5, 0);
        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            cnt[x]++;
        }
        int ans = 0;
        for (int x = 1; x < 4 * n + 2; x++) {
            if (cnt[x] > k) {
                int extra = cnt[x] - k;
                cnt[x] = k;
                cnt[x + 1] += extra;
                ans = max(ans, extra);
            }
        }

        vector<int> b;
        for (int x = 1; x < 4 * n + 2; x++) {
            for (int j = 0; j < cnt[x]; j++) {
                b.push_back(x);
            }
        }

        vector<int> freq(4 * n + 5, 0);
        for (int x : b) {
            freq[x]++;
        }
        ans = 0;
        while (true) {
            bool changed = false;
            for (int x = 1; x < 4 * n + 2; x++) {
                if (freq[x] > k) {
                    int extra = freq[x] - k;
                    freq[x] = k;
                    freq[x + 1] += extra;
                    changed = true;
                }
            }

            if (!changed)
                break;

            ans++;
        }
        cout << ans << '\n';
    }

    return 0;
}
